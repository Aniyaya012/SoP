{
  "definitions": {
    "severity": "人员伤亡和直接威胁的严重程度，越高越严重",
    "uncertainty": "事件原因、责任或信息的不确定程度，越高越不确定",
    "security_restriction": "检查、登记和临时管控对日常自由的限制程度，越高限制越强",
    "economic_disruption": "对出行、企业和就业造成的经济扰动，越高扰动越大",
    "transparency": "政府公开证据、解释和信息的充分程度，越高越透明",
    "accountability": "调查、问责和纠错行动的明确程度，越高越充分",
    "rights_protection": "对公民权利、公平和非歧视的保护信号，越高越强",
    "international_scrutiny": "国际组织或其他国家监督和批评的强度，越高越强",
    "reopening_pressure": "要求尽快恢复地铁和经济活动的压力，越高越强"
  },
